# Copy to .env and fill in. Never commit .env.
# Generate a key: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"

APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/New_York
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loaded_valet
DB_USER=loaded
DB_PASS=

# Used only by bin/seed.php to create the first owner. Not shown on the public site.
ADMIN_NAME=Anthony Jaamal Jones
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_NAME=lvt_session
